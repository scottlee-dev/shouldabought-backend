### ============================================
### SHOULDABOUGHT API VALIDATION TEST
### ============================================


### 0. DB RESET

#
# TRUNCATE TABLE
#     dividend_entitlements,
#     transactions,
#     dividends,
#     stock_prices,
#     accounts
# RESTART IDENTITY CASCADE;


### 1. Create Account
POST http://localhost:8080/api/accounts
Content-Type: application/json

{
  "name": "Test Account",
  "initialCash": 20000
}


### 2. Get Account
GET http://localhost:8080/api/accounts/1


### 3. Buy $1000 of AAPL
# AAPL price is refreshed automatically from Alpha Vantage.
POST http://localhost:8080/api/accounts/1/buy
Content-Type: application/json

{
  "symbol": "AAPL",
  "cashAmount": 1000
}


### 4. Get Transactions
GET http://localhost:8080/api/accounts/1/transactions


### 5. Get Positions
GET http://localhost:8080/api/accounts/1/positions


### 6. Get Balance
GET http://localhost:8080/api/accounts/1/balance


### 7. Get Portfolio
GET http://localhost:8080/api/accounts/1/portfolio


### 8. Sell $100 of AAPL
# AAPL price is refreshed again before selling.
POST http://localhost:8080/api/accounts/1/sell
Content-Type: application/json

{
  "symbol": "AAPL",
  "cashAmount": 100
}


### 9. Transactions After Sell
GET http://localhost:8080/api/accounts/1/transactions


### 10. Portfolio After Sell
GET http://localhost:8080/api/accounts/1/portfolio


### 11. Health Check
GET http://localhost:8080/api/health


### 12. Morning Market Job
POST http://localhost:8080/api/jobs/market/morning


### 13. Closing Market Job
POST http://localhost:8080/api/jobs/market/closing
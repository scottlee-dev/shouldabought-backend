### 1. Create Account
# Initial Deposit: $25,000.00
POST http://localhost:8080/api/accounts
Content-Type: application/json

{
  "name": "Main Trading Account",
  "initialCash": 25000.00
}


### 2. Buy AAPL
# 10 shares @ $150.00 = $1,500.00
POST http://localhost:8080/api/accounts/1/buy
Content-Type: application/json

{
  "symbol": "AAPL",
  "quantity": 10
}


### 3. Buy AAPL Again
# 10 shares @ $150.00 = $1,500.00
POST http://localhost:8080/api/accounts/1/buy
Content-Type: application/json

{
  "symbol": "AAPL",
  "quantity": 10
}


### 4. Buy TSLA
# 10 shares @ $200.00 = $2,000.00
POST http://localhost:8080/api/accounts/1/buy
Content-Type: application/json

{
  "symbol": "TSLA",
  "quantity": 10
}


### 5. Get Account Positions
# Expected: AAPL = 20 shares, TSLA = 10 shares
GET http://localhost:8080/api/accounts/1/positions


### 6. Set Market Price - AAPL
# Current Market Price: $150.00
POST http://localhost:8080/api/market/prices
Content-Type: application/json

{
  "symbol": "AAPL",
  "price": 150.00
}


### 7. Set Market Price - TSLA
# Current Market Price: $200.00
POST http://localhost:8080/api/market/prices
Content-Type: application/json

{
  "symbol": "TSLA",
  "price": 200.00
}


### 8. Get Account Balance
# Expected:
# Cash = $20,000.00
# AAPL = 20 × $150 = $3,000.00
# TSLA = 10 × $200 = $2,000.00
# Total Balance = $25,000.00
GET http://localhost:8080/api/accounts/1/balance


### 9. Sell AAPL by Quantity
# Sell 5 shares @ current market price ($150.00)
POST http://localhost:8080/api/accounts/1/sell
Content-Type: application/json

{
  "symbol": "AAPL",
  "quantity": 5
}


### 10. Get Account Positions
# Expected: AAPL = 15 shares, TSLA = 10 shares
GET http://localhost:8080/api/accounts/1/positions


### 11. Buy AAPL by Dollar Amount
# Buy $1,000 worth of AAPL at the current market price
POST http://localhost:8080/api/accounts/1/buy
Content-Type: application/json

{
  "symbol": "AAPL",
  "cashAmount": 1000
}


### 12. Sell AAPL by Dollar Amount
# Sell $1,000 worth of AAPL at the current market price
POST http://localhost:8080/api/accounts/1/sell
Content-Type: application/json

{
  "symbol": "AAPL",
  "cashAmount": 1000
}


### 13. Get Portfolio
# Expected:
# Cash
# AAPL quantity, current price, market value,
# average cost, gain/loss, account percentage
# TSLA quantity, current price, market value,
# average cost, gain/loss, account percentage
# Total account value and total gain/loss
GET http://localhost:8080/api/accounts/1/portfolio
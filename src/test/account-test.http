### 1. Create Account
# Initial Cash: $20,000
POST http://localhost:8080/api/accounts
Content-Type: application/json

{
  "name": "FIFO Multi-Lot Test",
  "initialCash": 20000.00
}


### 2. Set AAPL Price = $100
POST http://localhost:8080/api/market/prices
Content-Type: application/json

{
  "symbol": "AAPL",
  "price": 100.00
}


### 3. Buy 10 AAPL @ $100
# FIFO Lot 1
# 10 shares
# Cost = $1,000
POST http://localhost:8080/api/accounts/1/buy
Content-Type: application/json

{
  "symbol": "AAPL",
  "quantity": 10
}


### 4. Set AAPL Price = $120
POST http://localhost:8080/api/market/prices
Content-Type: application/json

{
  "symbol": "AAPL",
  "price": 120.00
}


### 5. Buy 20 AAPL @ $120
# FIFO Lot 2
# 20 shares
# Cost = $2,400
POST http://localhost:8080/api/accounts/1/buy
Content-Type: application/json

{
  "symbol": "AAPL",
  "quantity": 20
}


### 6. Set AAPL Price = $140
POST http://localhost:8080/api/market/prices
Content-Type: application/json

{
  "symbol": "AAPL",
  "price": 140.00
}


### 7. Buy 30 AAPL @ $140
# FIFO Lot 3
# 30 shares
# Cost = $4,200
POST http://localhost:8080/api/accounts/1/buy
Content-Type: application/json

{
  "symbol": "AAPL",
  "quantity": 30
}


### 8. Get Portfolio Before Sell
# Expected:
# Total Quantity = 60
# Total Cost = $7,600
# Current Market Value = $8,400
# Unrealized Gain = +$800
GET http://localhost:8080/api/accounts/1/portfolio


### 9. Sell 25 AAPL @ $140
# SELL 25 shares.
# FIFO consumes Lot 1 (10 @ $100) and Lot 2 (15 @ $120).
# Realized Gain = +$700
POST http://localhost:8080/api/accounts/1/sell
Content-Type: application/json

{
  "symbol": "AAPL",
  "quantity": 25
}


### 10. Get Portfolio After FIFO Sell
# Remaining: 35 AAPL (Lot 2: 5 @ $120, Lot 3: 30 @ $140)
# Current Market Value: 35 × $140 = $4,900
# Cash: $15,900
# Total Value: $20,800
GET http://localhost:8080/api/accounts/1/portfolio


### 11. Process Cash Dividend (reinvest = false)
# Amount per share: $0.20
# Total Cash Dividend: 35 × $0.20 = $7.00
# EXPECTED RESULT: Cash = $15,907.00, Stock Quantity = 35 AAPL
POST http://localhost:8080/api/accounts/1/dividends
Content-Type: application/json

{
  "externalId": "AAPL-2026-Q3-DIV",
  "symbol": "AAPL",
  "amountPerShare": 0.20,
  "declarationDate": "2026-08-01",
  "exDividendDate": "2026-08-05",
  "recordDate": "2026-08-06",
  "payDate": "2026-08-15",
  "reinvest": false
}


### 12. Duplicate Dividend Prevention Test
# Trying to process the SAME externalId ("AAPL-2026-Q3-DIV") again.
# EXPECTED RESULT: HTTP 500 / Exception ("Dividend already processed: AAPL-2026-Q3-DIV")
POST http://localhost:8080/api/accounts/1/dividends
Content-Type: application/json

{
  "externalId": "AAPL-2026-Q3-DIV",
  "symbol": "AAPL",
  "amountPerShare": 0.20,
  "declarationDate": "2026-08-01",
  "exDividendDate": "2026-08-05",
  "recordDate": "2026-08-06",
  "payDate": "2026-08-15",
  "reinvest": false
}


### 13. Check Balance After Cash Dividend
# EXPECTED: Cash Balance = $15,907.00
GET http://localhost:8080/api/accounts/1/balance


### 14. Refresh Live AAPL Price via Alpha Vantage API
# Fetch and update live market price for AAPL prior to DRIP execution
POST http://localhost:8080/api/market/prices/refresh/AAPL


### 15. Process DRIP Dividend (reinvest = true)
# CURRENT STATE BEFORE DRIP: Owned Shares = 35 AAPL, Cash = $15,907.00
# Total Dividend Paid: 35 × $0.28 = $9.80
# Reinvestment Shares = $9.80 / (Refreshed Live AAPL Price)
POST http://localhost:8080/api/accounts/1/dividends
Content-Type: application/json

{
  "externalId": "AAPL-2026-Q4-DIV",
  "symbol": "AAPL",
  "amountPerShare": 0.28,
  "declarationDate": "2026-09-01",
  "exDividendDate": "2026-09-05",
  "recordDate": "2026-09-06",
  "payDate": "2026-09-15",
  "reinvest": true
}


### 16. Get Final Portfolio After Price Refresh & DRIP
# Verify final share quantity, Cost Basis, Market Value, and Total Value based on live refreshed AAPL price
GET http://localhost:8080/api/accounts/1/portfolio